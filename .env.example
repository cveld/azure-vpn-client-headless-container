# Copy this file to .env and fill in your own paths.
# .env is gitignored — personal machine configuration, never commit.

# ── Required ─────────────────────────────────────────────────────────────────
# Path to the secrets folder containing msalcache.json, azurevpnconfig.xml and token-cache/.
# Use a Windows path (backslashes); WSL scripts convert automatically.
SECRETS_DIR=C:\Users\YOUR_NAME\path\to\vpn-secrets

# ── Optional ──────────────────────────────────────────────────────────────────
# Folder containing pre-existing .so files (libLinuxCore.so, libXplatSharedLibrary.so, libmat.so).
# When set, fetch-libs.ps1/sh skips the apt download and copies directly.
# Use a Windows path.
# LIBS_SOURCE=C:\path\to\existing\libs

# DEB version to download via apt (only relevant when LIBS_SOURCE is not set).
# Leave empty for the latest version.
# DEB_VERSION=3.0.0
