FROM ubuntu:22.04

# Runtime-deps van libLinuxCore.so + libXplatSharedLibrary.so
RUN apt-get update && apt-get install -y \
    libcurl4 \
    libcap2 \
    libsystemd0 \
    libssl3 \
    libsqlite3-0 \
    iproute2 \
    gcc \
    g++ \
    libc6-dev \
    strace \
    binutils \
    busybox \
    && rm -rf /var/lib/apt/lists/*

# Microsoft libs (gevuld door fetch-libs.sh → src/libs/)
COPY libs/ /opt/microsoft/lib/
ENV LD_LIBRARY_PATH=/opt/microsoft/lib

# Shim compileren
COPY vpnshim.cpp /src/vpnshim.cpp
RUN g++ -O0 -g -std=c++17 -o /vpnshim /src/vpnshim.cpp -ldl -lpthread \
    && echo "Compilatie OK"

# LD_PRELOAD cert-redirect interceptor
COPY certredirect.c /src/certredirect.c
RUN gcc -O2 -fPIC -shared -o /certredirect.so /src/certredirect.c -ldl \
    && echo "certredirect OK"

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Syslogd is VERPLICHT: zonder syslogd crasht Go's logrus (nil Logger in CacheAccessor)
ENTRYPOINT ["/entrypoint.sh"]
