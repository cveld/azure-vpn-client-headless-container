# OpenVPN client config for the Azure-Entra-patched build (src-openvpn/).
# connect-vpn-openvpn.ps1 renders __GATEWAY__ from the selected profile and
# mounts this file, alongside tls-auth.key / dr.pem / creds / up-dns.sh, at
# /work inside the container.
client
remote __GATEWAY__ 443
proto tcp
dev tun
nobind
resolv-retry infinite

remote-cert-tls server
auth SHA256
cipher AES-256-GCM
data-ciphers AES-256-GCM
data-ciphers-fallback AES-256-GCM

tls-timeout 30
reneg-sec 0
persist-key
persist-tun

# tls-auth key = the profile's <serversecret>, client key-direction = 1.
tls-auth /work/tls-auth.key 1
ca /work/dr.pem
auth-user-pass /work/creds

# Refresh DNS even on soft reconnects with persist-tun, and restore Docker DNS
# while disconnected so the gateway can still be resolved.
script-security 2
up /work/up-dns.sh
down /work/up-dns.sh
down-pre
up-restart

verb 3
