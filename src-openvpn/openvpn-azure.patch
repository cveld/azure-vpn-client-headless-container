@@ -66,7 +66,11 @@ struct user_pass
 #ifdef ENABLE_PKCS11
 #define USER_PASS_LEN 4096
 #else
-#define USER_PASS_LEN 128
+/* AZURE (re/openvpn experiment): the Entra access token is the OpenVPN password
+ * and is ~2.3 KB. The stock 128-byte limit silently truncates it to 127 chars,
