diff --git a/src/openvpn/ssl_openssl.c b/src/openvpn/ssl_openssl.c
index 2595f87..6d88bfb 100644
--- a/src/openvpn/ssl_openssl.c
+++ b/src/openvpn/ssl_openssl.c
@@ -1920,6 +1920,26 @@ bio_read(BIO *bio, struct buffer *buf, const char *desc)
     return ret;
 }
 
+/* AZURE (re/openvpn experiment): NSS-format TLS keylog for offline decryption.
+ * Enabled by setting OPENVPN_KEYLOG to a writable path; each secret is appended
+ * so tshark -o tls.keylog_file:<path> can decrypt the control-channel TLS. */
+static void
+az_keylog_cb(const SSL *ssl, const char *line)
+{
+    (void) ssl;
+    const char *path = getenv("OPENVPN_KEYLOG");
+    if (!path || !*path)
+    {
+        return;
+    }
+    FILE *f = fopen(path, "a");
+    if (f)
+    {
+        fprintf(f, "%s\n", line);
+        fclose(f);
+    }
+}
+
 void
 key_state_ssl_init(struct key_state_ssl *ks_ssl, const struct tls_root_ctx *ssl_ctx, bool is_server, struct tls_session *session)
 {
@@ -1937,6 +1957,61 @@ key_state_ssl_init(struct key_state_ssl *ks_ssl, const struct tls_root_ctx *ssl_
      * from verify callback*/
     SSL_set_ex_data(ks_ssl->ssl, mydata_index, session);
 
+    /* AZURE (re/openvpn experiment): stock OpenVPN sends no TLS SNI. The Azure
+     * multi-tenant VPN gateway front-end needs server_name to route the TLS
+     * session to the right tenant backend, and resets the handshake without it.
+     * Set SNI (client only) from the OPENVPN_SNI env var. */
+    if (!is_server)
+    {
+        const char *az_sni = getenv("OPENVPN_SNI");
+        if (az_sni && *az_sni)
+        {
+            SSL_set_tlsext_host_name(ks_ssl->ssl, az_sni);
+        }
+
+        /* AZURE (re/openvpn experiment): the Microsoft Azure VPN client's
+         * ClientHello additionally advertises ALPN (h2, http/1.1) and
+         * post_handshake_auth; stock OpenVPN sends neither. The Entra gateway
+         * front-end is HTTP/2-capable and appears to fingerprint/route on
+         * these, so match them. ALPN protocols come from OPENVPN_ALPN
+         * (comma-separated); PHA is enabled whenever OPENVPN_PHA is set. */
+        const char *az_alpn = getenv("OPENVPN_ALPN");
+        if (az_alpn && *az_alpn)
+        {
+            unsigned char wire[256];
+            size_t w = 0;
+            const char *p = az_alpn;
+            while (*p && w < sizeof(wire))
+            {
+                const char *comma = strchr(p, ',');
+                size_t seg = comma ? (size_t)(comma - p) : strlen(p);
+                if (seg > 0 && seg < 256 && w + 1 + seg <= sizeof(wire))
+                {
+                    wire[w++] = (unsigned char)seg;
+                    memcpy(wire + w, p, seg);
+                    w += seg;
+                }
+                if (!comma)
+                {
+                    break;
+                }
+                p = comma + 1;
+            }
+            if (w > 0)
+            {
+                SSL_set_alpn_protos(ks_ssl->ssl, wire, (unsigned int)w);
+            }
+        }
+        if (getenv("OPENVPN_PHA"))
+        {
+            SSL_set_post_handshake_auth(ks_ssl->ssl, 1);
+        }
+        if (getenv("OPENVPN_KEYLOG"))
+        {
+            SSL_CTX_set_keylog_callback(SSL_get_SSL_CTX(ks_ssl->ssl), az_keylog_cb);
+        }
+    }
+
     ASSERT((ks_ssl->ssl_bio = BIO_new(BIO_f_ssl())));
     ASSERT((ks_ssl->ct_in = BIO_new(BIO_s_mem())));
     ASSERT((ks_ssl->ct_out = BIO_new(BIO_s_mem())));
