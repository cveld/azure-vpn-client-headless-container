+        buf_printf(&out, "IV_VER=AzMac IV_PLAT=0.1 IV_PROTO=1 IV_PLAT_VER= IV_PLAT_DEVICE_ID=x64");
+        if (write_string(buf, BSTR(&out), -1))
+        {
+            ret = true;
+        }
+        gc_free(&gc);
+        return ret;
+    }
+    /* --- end AZURE override --- */
