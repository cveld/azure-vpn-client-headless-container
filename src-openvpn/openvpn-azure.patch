diff --git a/src/openvpn/options.c b/src/openvpn/options.c
index d23c179..37adbcf 100644
--- a/src/openvpn/options.c
+++ b/src/openvpn/options.c
@@ -4465,6 +4465,20 @@ options_string(const struct options *o,
 #undef TLS_CLIENT
 #undef TLS_SERVER
 
+    /* AZURE (re/openvpn experiment): emit the byte-exact OCC options string that
+     * the Microsoft Azure VPN client (libXplatSharedLibrary.so) sends on the
+     * wire (captured via LD_PRELOAD of SSL_write). The Entra gateway compares
+     * this string and resets the session on any mismatch. link-mtu/tun-mtu are
+     * fixed values the vendored client reports (1500/1551) that stock OpenVPN
+     * would not compute, so the whole client-side string is replaced verbatim.
+     * Only the local (sent) string is overridden; the peer-expected string is
+     * left as computed. Enabled by OPENVPN_AZURE_OCC. */
+    if (getenv("OPENVPN_AZURE_OCC") && !remote)
+    {
+        buf_clear(&out);
+        buf_printf(&out, "V4,dev-type tun,link-mtu 1500,tun-mtu 1551,proto TCPv4_CLIENT,keydir 1,cipher AES-256-GCM,auth [null-digest],keysize 256,tls-auth,key-method 2,tls-client");
+    }
+
     return BSTR(&out);
 }
 
