# Reproducible build of the Azure-Entra-patched OpenVPN.
#
# Self-contained: clones the pinned upstream release tag and applies
# openvpn-azure.patch. No dependency on a local OpenVPN clone.
#
#   Build context = this directory (src-openvpn), so the patch is in scope:
#     docker build -f src-openvpn/Containerfile -t azurevpn-openvpn:local src-openvpn
#
# To bump OpenVPN: change OPENVPN_TAG, regenerate openvpn-azure.patch against
# the new tag (git diff <tag> HEAD), and re-verify OCC/peer-info vs the vendored
# client (see openvpn-patch.md).
FROM ubuntu:24.04 AS build
ARG OPENVPN_TAG=v2.6.14
RUN apt-get update && apt-get install -y \
    build-essential pkg-config autoconf automake libtool \
    libssl-dev libpam0g-dev liblzo2-dev liblz4-dev libcap-ng-dev \
    git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pin to the official upstream release tag.
RUN git clone --depth 1 --branch "${OPENVPN_TAG}" \
      https://github.com/OpenVPN/openvpn.git /src/openvpn
WORKDIR /src/openvpn

# Apply the Azure-Entra patch (captured byte-for-byte from the vendored client).
COPY openvpn-azure.patch /tmp/openvpn-azure.patch
RUN git apply --verbose /tmp/openvpn-azure.patch \
 && echo "AZURE PATCH APPLIED"

# Robustness: strip any CR from autotools/shell files.
RUN find . -type f \( -name '*.ac' -o -name '*.am' -o -name '*.m4' -o -name '*.sh' \) \
      -exec sed -i 's/\r$//' {} +
# Ubuntu 24.04's libtoolize rejects ACLOCAL_AMFLAGS alongside AC_CONFIG_MACRO_DIRS.
RUN sed -i '/^ACLOCAL_AMFLAGS[[:space:]]*=/d' Makefile.am
# Git checkout (not a release tarball) -> generate ./configure.
RUN autoreconf -i -v -f
RUN ./configure --disable-dco --disable-plugins --disable-debug
# config-version.h is normally generated by the top-level `make` via a
# git-describe rule that misbehaves in a shallow clone. Generate a stub (the two
# macros are only shown in --version) so `make -C src/openvpn` finds it.
RUN printf '#define CONFIGURE_GIT_REVISION "%s"\n#define CONFIGURE_GIT_FLAGS ""\n' "${OPENVPN_TAG}" > config-version.h
RUN make -C src/compat -j"$(nproc)"
RUN make -C src/openvpn -j"$(nproc)" openvpn
RUN ./src/openvpn/openvpn --version | head -3 || true
# Prove the decisive patches are compiled in.
RUN strings src/openvpn/openvpn | grep -E "IV_PLAT_DEVICE_ID=x64" && echo "PEER-INFO PATCH PRESENT" \
 && strings src/openvpn/openvpn | grep -E "tun-mtu 1551,proto TCPv4_CLIENT" && echo "OCC PATCH PRESENT"

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y \
    libssl3 liblzo2-2 liblz4-1 libpam0g libcap-ng0 iproute2 iputils-ping \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/openvpn/src/openvpn/openvpn /usr/local/sbin/openvpn
ENTRYPOINT ["/usr/local/sbin/openvpn"]
